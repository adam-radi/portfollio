// Prisma Schema for Adam Radi Portfolio — MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Admin User ───────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String   // bcrypt hashed
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ── Project ──────────────────────────────────────────────────────────────────
// MySQL has no native array type — we use Json for arrays of strings

model Project {
  id             String   @id @default(cuid())
  title          String   @db.VarChar(255)
  slug           String   @unique @db.VarChar(255)
  description    String   @db.Text
  overview       String   @db.Text
  problem        String   @db.Text
  solution       String   @db.Text
  technologies   Json     // string[]
  features       Json     // string[]
  challenges     Json     // string[]
  lessonsLearned Json     // string[]
  image          String   @db.VarChar(500)
  githubUrl      String?  @db.VarChar(500)
  liveUrl        String?  @db.VarChar(500)
  featured       Boolean  @default(false)
  published      Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("projects")
}

// ── Experience ───────────────────────────────────────────────────────────────

model Experience {
  id           String   @id @default(cuid())
  company      String   @db.VarChar(255)
  role         String   @db.VarChar(255)
  location     String   @db.VarChar(255)
  startDate    String   @db.VarChar(20)  // "YYYY-MM"
  endDate      String?  @db.VarChar(20)  // "YYYY-MM" or null
  description  Json     // string[]
  technologies Json     // string[]
  current      Boolean  @default(false)
  companyLogo  String?  @db.VarChar(500) // logo image path/url
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("experiences")
}

// ── Skill ────────────────────────────────────────────────────────────────────

model Skill {
  id                String   @id @default(cuid())
  name              String   @db.VarChar(100)
  category          String   @db.VarChar(50)  // frontend | backend | database | devops | tools | dental
  icon              String?  @db.VarChar(100)
  level             String   @default("intermediate") @db.VarChar(50) // beginner | intermediate | advanced | expert
  description       String?  @db.Text
  yearsOfExperience Int?     @default(0)
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("skills")
}

// ── Certification ─────────────────────────────────────────────────────────────

model Certification {
  id             String   @id @default(cuid())
  title          String   @db.VarChar(255)
  issuer         String   @db.VarChar(255)
  date           String   @db.VarChar(20) // "YYYY-MM"
  expirationDate String?  @db.VarChar(20) // "YYYY-MM" or null
  credentialId   String?  @db.VarChar(255)
  credentialUrl  String?  @db.VarChar(500)
  description    String?  @db.Text
  image          String?  @db.VarChar(500)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("certifications")
}

// ── Message (Contact Form) ────────────────────────────────────────────────────

model Message {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  email     String   @db.VarChar(255)
  subject   String   @db.VarChar(500)
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("messages")
}

// ── Review (public testimonials — admin moderated) ────────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Acquisition source — how the visitor found the portfolio ("How did you find
// me?"). Internal analytics only: never rendered on the public site.
// Nullable so rows written before this field existed keep working; those rows
// stay NULL and are reported as "Not specified" instead of guessing history.
// Adding a source later only requires: enum value + entry in types/review.ts.
enum ReviewSource {
  GOOGLE_SEARCH
  LINKEDIN
  INSTAGRAM
  FACEBOOK
  GITHUB
  YOUTUBE
  TIKTOK
  REFERRAL
  OTHER
}

model Review {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(120)
  role        String?       @db.VarChar(120)
  company     String?       @db.VarChar(120)
  content     String        @db.Text
  rating      Int           // 1–5, validated in application layer
  linkedinUrl String?       @db.VarChar(500)
  websiteUrl  String?       @db.VarChar(500)
  source      ReviewSource? // required by validation on submit; NULL = legacy row
  status      ReviewStatus  @default(PENDING) // never auto-approved
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@map("reviews")
}

// ── Article (Insights / Blog) ─────────────────────────────────────────────────

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model Article {
  id          String        @id @default(cuid())
  title       String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(255)
  excerpt     String        @db.Text
  content     String        @db.LongText
  coverImage  String?       @db.VarChar(500)
  category    String        @db.VarChar(100)
  tags        Json          // string[]
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  authorName  String        @default("Adam Radi") @db.VarChar(255)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("articles")
}


// ── Like (anonymous visitor engagement — one like per visitor per entity) ────
// entityType + entityId form a polymorphic reference to Project / Skill /
// Article / Review. No relation columns are added to those models: likes are
// an optional engagement signal, never part of the content contract.

enum LikeEntityType {
  PROJECT
  SKILL
  ARTICLE
  REVIEW
}

model Like {
  id         String         @id @default(cuid())
  entityType LikeEntityType
  entityId   String         @db.VarChar(128) // target Project/Skill/Article/Review id
  visitorId  String         @db.VarChar(32)  // anonymous id from the httpOnly visitor cookie
  createdAt  DateTime       @default(now())

  // Uniqueness: a visitor can never create duplicate likes.
  // The (entityType, entityId) index prefix also serves like-count queries.
  @@unique([entityType, entityId, visitorId])
  @@index([visitorId])

  @@map("likes")
}
